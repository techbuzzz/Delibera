<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <RootNamespace>Delibera.Server</RootNamespace>
    <AssemblyName>Delibera.Server</AssemblyName>
    <UserSecretsId>delibera-server-secrets</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <!-- NuGet package metadata.
       Microsoft.NET.Sdk.Web does not inherit the library defaults, so every field Core gets for
       free has to be stated here: otherwise the package ships with no description, no licence
       expression and no icon, and nuget.org rejects it. -->
  <PropertyGroup>
    <PackageId>Delibera.Server</PackageId>
    <!-- Microsoft.NET.Sdk.Web sets IsPackable=false because the Web SDK's default output is an
         app, not a library. This project ships as a reusable library, so it must opt back in. -->
    <IsPackable>true</IsPackable>
    <Version>10.5.1</Version>
    <Title>Delibera Server</Title>
    <Description>ASP.NET Core host for the Delibera multi-model AI council framework: debate, scenario, corpus, SSE streaming and MCP endpoints mountable inside an existing application through AddDeliberaServer/UseDeliberaServer. All routes live under /api/v1 so they cannot collide with your own endpoints. Depends on Delibera.Core.</Description>
    <Authors>Victor Buzin</Authors>
    <PackageTags>llm;ai;debate;council;deliberation;aspnetcore;minimal-api;server;api;sse;server-sent-events;mcp;model-context-protocol;rag;opentelemetry;serilog;multi-model</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/techbuzzz/Delibera</PackageProjectUrl>
    <RepositoryUrl>https://github.com/techbuzzz/Delibera</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>First GA release of Delibera.Server as a standalone package.

The 10.5.0 package page for Delibera.Core shows a 514-test figure; that number was measured at 10.4.0. At the 10.5.0 tag the count was 532, and at this release it is 611 (493 Core + 108 Server + 10 gRPC contract). This package ships with the corrected numbers.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- icon.png and README.md must physically exist next to the csproj: a PackageIcon or
       PackageReadmeFile pointing at ..\..\ does not resolve during pack. -->
  <ItemGroup>
    <None Include="icon.png" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core -->
    <ProjectReference Include="..\Delibera.Core\Delibera.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET / Minimal API -->
    <!-- Microsoft.OpenApi 3.x makes IOpenApiMediaType.Example read-only, which breaks
         the AspNetCore.OpenApi source generator (it emits Example = ... in the
         generated OpenApiXmlCommentSupport code). Pin to 2.7.x until the source
         generator is updated for v3.
         Evidence: with Microsoft.OpenApi 3.10.2 and Microsoft.AspNetCore.OpenApi
         10.0.12 the generator still emits `Example = ...` assignments against the
         read-only IOpenApiMediaType.Example, and the build fails with CS0200
         (CS0200: property or indexer 'Example' cannot be assigned to, it is read only)
         inside generated OpenApiXmlCommentSupport code. Re-tested and reverted
         3.10.2 -> 2.7.5 for the 10.4.0 release gate; do not retry 3.x until the
         generator ships v3-aware emission.
         The floor matters: Microsoft.AspNetCore.OpenApi 10.0.12 declares
         Microsoft.OpenApi [2.12.0, 3.0.0), so an explicit 2.7.5 pin does not restore —
         it is NU1605 (detected package downgrade 2.12.0 -> 2.7.5), which is an error here.
         2.12.2 is the last published 2.x, so it is both the floor-satisfying pin and the
         highest version that still has the settable IOpenApiMediaType.Example. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />

    <!-- MCP Server (HTTP transport) -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />

    <!-- Validation -->
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />

    <!-- Observability -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <!-- NU1510: Microsoft.AspNetCore.Http.Extensions and                                        -->
    <!--         Microsoft.Extensions.Diagnostics.HealthChecks are implicit in                  -->
    <!--         Microsoft.NET.Sdk.Web — removed explicit references.                           -->
  </ItemGroup>

</Project>
