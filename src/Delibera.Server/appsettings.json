{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Delibera": {
    "Server": {
      "Telemetry": {
        "OtlpEndpoint": ""
      }
    },
    "Strategy": "Standard",
    "MaxRounds": 4,
    "Temperature": 0.7,
    "Providers": {
      "DefaultType": "Ollama",
      "DefaultEndpoint": "http://ollama:11434",
      "DefaultModel": "qwen2.5:14b",
      "EmbeddingModel": "nomic-embed-text"
    },
    "Compression": {
      "Enabled": true,
      "Strategy": "Hybrid",
      "TargetRatio": 0.5
    },
    "Rag": {
      "Enabled": false,
      "ProviderType": "Qdrant",
      "ConnectionString": "http://qdrant:6333"
    },
    "Output": {
      "Directory": "./debate_results",
      "SeparateFiles": true
    }
  }
}
