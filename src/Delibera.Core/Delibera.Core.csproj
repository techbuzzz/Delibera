<Project Sdk="Microsoft.NET.Sdk">

   <PropertyGroup>
      <TargetFramework>net10.0</TargetFramework>
      <ImplicitUsings>enable</ImplicitUsings>
      <Nullable>enable</Nullable>
      <LangVersion>preview</LangVersion>
      <GenerateDocumentationFile>true</GenerateDocumentationFile>
      <Deterministic>true</Deterministic>
      <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
      <NoWarn>$(NoWarn);CS9057</NoWarn>

      <!-- NuGet Package Metadata -->
      <PackageId>Delibera.Core</PackageId>
       <Version>10.2.6</Version>
      <Title>Delibera</Title>
      <Description>Delibera â€” Thoughtful AI Decisions. A framework for collective decision making through structured AI deliberation. Supports multi-model councils with RAG (Qdrant, PgVector), debate strategies, Knowledge Keeper, Chairman roles, dependency injection, context compression, AutoChunking (progressive disclosure for large documents), Microsoft.Extensions.Logging, Microsoft.Extensions.Http.Resilience (Polly v8 retry pipelines), IHttpClientFactory wiring, response-language enforcement, parallel Operator requests, and full cooperative CancellationToken support across every async public method (rounds, LLM calls, MCP tools, RAG, file saves). v10.2.6 adds: async streaming council (IAsyncEnumerable&lt;DebateRound&gt;), pluggable voting engine (Majority/BordaCount/Weighted), debate persistence &amp; resume via checkpoints, agent memory (in-memory/Qdrant/pgvector), OpenTelemetry-style observability (spans + metrics), structured JSON output (schema-validated verdicts with retry), adaptive strategy switching on stagnation, debate templates &amp; presets library, HTML export, debate timeout, persona presets, benchmark mode, and participant limit guard.</Description>
      <Authors>Victor Buzin</Authors>
      <Company>Techbuzzz</Company>
      <Product>Delibera</Product>
      <Copyright>Copyright Â© 2026 Techbuzzz</Copyright>
      <PackageTags>llm;ai;debate;council;deliberation;rag;qdrant;pgvector;ollama;openai;vector-search;embeddings;dependency-injection;resilience;polly;retry;httpclient;autochunking;chunking;context-window;cancellation;cancellationtoken;ct;streaming;async-enumerable;voting;persistence;checkpoint;memory;structured-output;json-schema;opentelemetry;adaptive;html-export;persona;benchmark;templates</PackageTags>
      <PackageReadmeFile>README.md</PackageReadmeFile>
      <PackageIcon>icon.png</PackageIcon>
      <PackageLicenseExpression>MIT</PackageLicenseExpression>
      <RepositoryUrl>https://github.com/techbuzzz/Delibera</RepositoryUrl>
      <RepositoryType>git</RepositoryType>
      <PackageProjectUrl>https://github.com/techbuzzz/Delibera</PackageProjectUrl>
       <PackageReleaseNotes>v10.2.6 — Large feature release delivering nine new capabilities across observability, DX, enterprise decision support, persistence, and memory. Added: F-08 OpenTelemetry-style observability (DeliberaActivitySource + DeliberaMeter); F-10 Quick Wins Bundle (HtmlExporter, WithTimeout, 6 Persona presets, CouncilBenchmark, WithParticipantLimit); F-07 Debate Templates (6 built-in templates); F-01 Async Streaming Council (ICouncilExecutor.StreamDebateAsync with DebateRound.Total/IsFinal); F-09 Dynamic Strategy Switching (IStrategySelector + AdaptiveStrategySelector with Levenshtein fallback); F-02 Pluggable Vote Engine (IVotingStrategy + Majority/BordaCount/Weighted strategies + Chairman.CreateVoting); F-05 Structured Output (IStructuredOutputSerializer + JsonSchemaOutputSerializer + ExecuteTypedAsync&lt;T&gt; with retry); F-03 Debate Persistence (IDebateStore + FileDebateStore with atomic write-then-rename + ResumeFrom); F-04 Agent Memory (IAgentMemory + InMemory/Qdrant/PgVector implementations). 9 new ConsoleApp --flag demos. Fixed: CouncilMember.PersonaPrompt now assigned in constructor. 163 new unit tests; all 259 tests pass; no breaking changes — all new features are opt-in. v10.2.5 — OllamaProvider maxOutputTokens parameter fix. v10.2.4 — Full cooperative CancellationToken support. v10.2.3 — v10.2.0 — AutoChunking, Polly v8, parallel Operator, response language, logging, M.E.AI ChatClient bridge.</PackageReleaseNotes>
      <IncludeSymbols>true</IncludeSymbols>
      <SymbolPackageFormat>snupkg</SymbolPackageFormat>
      <PublishRepositoryUrl>true</PublishRepositoryUrl>
      <EmbedUntrackedSources>true</EmbedUntrackedSources>
   </PropertyGroup>

   <ItemGroup>
      <None Include="icon.png" Pack="true" PackagePath="\" />
      <None Include="README.md" Pack="true" PackagePath="\" />
   </ItemGroup>

