{
  "name": "delibera-site",
  "version": "10.5.2",
  "private": true,
  "type": "module",
  "description": "Project website for Delibera - static Next.js export published to GitHub Pages",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "predev": "npm run sync-assets",
    "dev": "next dev",
    "prebuild": "npm run sync-assets",
    "build": "next build",
    "verify": "node scripts/verify-export.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "marked": "^15.0.7",
    "next": "16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.3"
  }
}