# ─────────────────────────────────────────────────────────────────────────────
# Delibera environment configuration
#
# SECURITY: the Delibera API has NO authentication and NO rate limiting. Anyone who
# can reach the port can start debates that spend real LLM credits. The compose file
# binds every published port to 127.0.0.1 for that reason — do not change it to 0.0.0.0
# without putting an authenticating reverse proxy in front first.
#
# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Build ────────────────────────────────────────────────────────────────────────
BUILD_CONFIGURATION=Release
IMAGE_TAG=latest

# ── Server ───────────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
# Host port the server listens on (maps to container :8080).
# Published on 127.0.0.1 only — see the security note at the top of this file.
DELIBERA_PORT=5200

# ── WebUI ───────────────────────────────────────────────────────────────────────
# Host port the Nuxt web UI listens on (maps to container :3000).
WEBUI_PORT=3000
# Tenant sent as X-Tenant-Id by the UI's server-side proxy. The API falls back to
# "default" when the header is absent, so this is set explicitly.
DELIBERA_TENANT_ID=default

# ── LLM Provider ──────────────────────────────────────────────────────────────────
# Ollama (local / Docker):
DELIBERA_PROVIDER_TYPE=Ollama
# DELIBERA_PROVIDER_ENDPOINT=http://ollama:11434 - Use if running Ollama in a container (default)
DELIBERA_PROVIDER_ENDPOINT=http://host.docker.internal:11434
DELIBERA_MODEL=qwen2.5:14b
DELIBERA_EMBEDDING_MODEL=nomic-embed-text
# Leave blank for Ollama; fill in for OpenAI / AzureOpenAI / Anthropic:
DELIBERA_API_KEY=

# Ollama model pull list (space-separated, used by ollama-pull service)
OLLAMA_PULL_MODELS=qwen2.5:14b nomic-embed-text

# ── Debate defaults ───────────────────────────────────────────────────────────────
DELIBERA_STRATEGY=Standard
DELIBERA_MAX_ROUNDS=4
DELIBERA_TEMPERATURE=0.7

# ── Compression ──────────────────────────────────────────────────────────────────
DELIBERA_COMPRESSION_ENABLED=true
DELIBERA_COMPRESSION_STRATEGY=Hybrid
DELIBERA_COMPRESSION_TARGET_RATIO=0.5

# ── RAG ──────────────────────────────────────────────────────────────────────────
DELIBERA_RAG_ENABLED=false
# Qdrant or PgVector
DELIBERA_RAG_PROVIDER=Qdrant
DELIBERA_RAG_CONNECTION=http://qdrant:6333

# ── PostgreSQL (pgvector) ─────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=council_vectors
POSTGRES_PORT=5432

# ── Redis ────────────────────────────────────────────────────────────────────────
# Off by default. When enabled, the server replaces its in-process debate orchestrator
# with the Redis-backed one: round events and debate state are shared through Redis
# Streams, so several API instances can serve the same debates.
#
# This is NOT distributed turn execution — DebateWorkerService is a documented no-op
# placeholder, so each debate still runs in the process that accepted it.
DELIBERA_REDIS_ENABLED=false
DELIBERA_REDIS_CACHE_ENABLED=false
DELIBERA_REDIS_CONNECTION=redis:6379,abortConnect=false
DELIBERA_REDIS_STREAM_MAX_LENGTH=10000
# TimeSpan format for the debate state key TTL (24 hours).
DELIBERA_REDIS_STATE_TTL=24:00:00

# ── Observability (OpenTelemetry) ───────────────────────────────────────────────
# Leave blank to log traces to console instead of an OTLP collector
OTEL_EXPORTER_OTLP_ENDPOINT=
